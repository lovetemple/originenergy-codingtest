{
  "compilerOptions": {
    "target": "ES2022",                    // Use modern JS features
    "module": "ESNext",                     // Use ES modules
    "moduleResolution": "node",             // Resolve modules like Node.js
    "lib": ["ES2022"],                      // Only standard JS features needed
    "types": ["node", "@playwright/test"], // Include Node.js and Playwright types
    "resolveJsonModule": true,              // Allow importing JSON files
    "esModuleInterop": true,                // Allow default imports from CommonJS
    "allowSyntheticDefaultImports": true,   // Smooth interop with JS modules
    "forceConsistentCasingInFileNames": true, // Enforce consistent file casing
    "strict": true,                         // Enable all strict type-checking options
    "skipLibCheck": true,                   // Skip type-checking of node_modules
    "outDir": "./dist",                      // Optional if you compile TS outside tests
    "allowJs": true                          // If you have JS files to include
  },
  "include": [
    "tests/**/*",
    "src/**/*",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "playwright-report",
    "test-results"
  ]
}
